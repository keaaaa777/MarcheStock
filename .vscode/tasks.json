{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Marche Stock: ローカルサーバー起動",
      "type": "shell",
      "command": "npm start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "marche-stock",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Inventory app: http://localhost:4173",
          "endsPattern": "Inventory app: http://localhost:4173"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
